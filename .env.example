# Copy this file to .env in the same folder, then paste your values after each =
# Never paste keys into chat.

# Nosana API key, created after your credit claim is approved
NOSANA_API_KEY=

# ElevenLabs key for the video voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Pexels key, optional, for stock photos and clips
PEXELS_API_KEY=

# Fly.io deploy token for the always-on gateway
FLY_API_TOKEN=
